    {
      "cell_type": "code",
      "metadata": {},
      "source": ["# Download a privacy‑safe demo dataset\n", "import os, urllib.request, zipfile\n", "demo_url = 'https://raw.githubusercontent.com/datablist/sample-csv-files/main/files/transactions.csv'  # real CSV URL\n", "os.makedirs('data/demo', exist_ok=True)\n", "zip_path = 'data/demo/demo.zip'\n", "urllib.request.urlretrieve(demo_url, zip_path)\n", "with zipfile.ZipFile(zip_path, 'r') as zip_ref:\n", "    zip_ref.extractall('data/demo')\n", "print('Demo data extracted')"],
